# Local development settings for the sync API (`npm run dev` in server/ reads server/.env).
#
# Copy to server/.env (gitignored). Production settings live in the repo-root .env.example.
# Full walkthrough: app/docs/cloud-sync.md.

# Any long random string: openssl rand -base64 32
SESSION_SECRET=

# The Google OAuth web client. Its Authorized redirect URIs must include the callback below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The app dev server (port 5173) forwards /api to this API, so the callback goes through it.
OAUTH_REDIRECT=http://localhost:5173/api/auth/callback
POST_LOGIN_REDIRECT=http://localhost:5173/

ALLOWED_EMAILS=matt.grochocinski@gmail.com

# Plain http on localhost: cookies must not require HTTPS, and there is no proxy in front.
COOKIE_SECURE=false
TRUST_PROXY=false

# SQLite file, relative to server/ (server/data/ is gitignored).
DB_PATH=./data/swu.db
