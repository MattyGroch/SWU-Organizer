# Production settings for docker-compose.yml.
#
# Copy to `.env` in this directory (it is gitignored) on the host. `docker compose` reads it
# to fill the ${VAR} slots in docker-compose.yml. When Portainer is back, the same names
# go in the stack's Environment variables instead.
#
# For local development of the API, see server/.env.example instead.

# Session signing key. Generate once and keep it stable (changing it signs everyone out):
#   openssl rand -base64 32
SESSION_SECRET=

# Google OAuth 2.0 web client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an Authorized redirect URI on that client.
OAUTH_REDIRECT=https://swu.mattyflix.com/api/auth/callback

# Where the browser lands after signing in.
POST_LOGIN_REDIRECT=https://swu.mattyflix.com/

# Comma-separated Google accounts allowed to sign in. Anyone else gets 403.
ALLOWED_EMAILS=matt.grochocinski@gmail.com
